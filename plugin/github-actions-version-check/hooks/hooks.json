{
  "description": "Validates GITHUB_TOKEN is set before running aver",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-github-token.sh"
          }
        ]
      }
    ]
  }
}
